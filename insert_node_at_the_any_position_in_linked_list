#include<stdio.h>
#include<stdlib.h>

struct node {
    int data;
    struct node *next;
};
typedef struct node *NODE;

NODE createNode(){
    NODE temp;
    temp = (NODE)malloc(sizeof(struct node));
    if(temp != NULL){
        printf("Memory allocation failed\n");
        return 0;
    }
    temp -> next = NULL;
    return temp;
}
NODE insertAtPosition(NODE first,int x,int pos){
    NODE temp,cur;
    int i;
    temp = createNode();
    temp -> data = x;
    
    if(pos == 1){
        temp -> next = first;
        return temp;
    }
    cur = first;
    for( i = 1 ; i < pos - 1 && cur != NULL ; i++){
        cur = cur -> next;
    }
    if(cur == NULL){
        printf("NOT");
        free(temp);
        return first;
    }
    temp -> next = cur -> next;
    cur -> next = temp;
    return first;
}
